{
    "name": "Deno",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu26.04",
    "features": {
        "ghcr.io/devcontainers-community/features/deno:1": {}
    },
    "postCreateCommand": "deno install",
    "customizations": {
        // --- VS CODE SETUP ---
        "vscode": {
            "extensions": [
                "denoland.vscode-deno"
            ],
            "settings": {
                "deno.enable": true,
                "deno.lint": true
            }
        }
    }
}
